<Window x:Class="MumbaiDCRChecker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mumbai DCR Compliance Checker" 
        Height="750" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl Name="MainTabControl" Margin="10">
            
            <!-- Tab 1: Project Information -->
            <TabItem Header="Project Information">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Mumbai DCR Compliance Checker" 
                                   FontSize="20" FontWeight="Bold" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Phase 4 - Fire Safety Compliance" 
                                   FontSize="12" Foreground="Gray"
                                   Margin="0,0,0,20"/>

                        <GroupBox Header="Zone &amp; Project Type" Padding="10" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Zone Type:"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Name="ZoneTypeCombo">
                                    <ComboBoxItem Content="City" IsSelected="True"/>
                                    <ComboBoxItem Content="Suburb"/>
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Project Type:"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Name="ProjectTypeCombo">
                                    <ComboBoxItem Content="Residential" IsSelected="True"/>
                                    <ComboBoxItem Content="Commercial"/>
                                    <ComboBoxItem Content="Mixed"/>
                                    <ComboBoxItem Content="Industrial"/>
                                </ComboBox>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Road Widths (meters)" Padding="10" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Front Road Width:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Name="NorthRoadWidthBox" Text="12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rear Road Width (0=none):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Name="SouthRoadWidthBox" Text="0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Side 1 Road Width (0=none):"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Name="EastRoadWidthBox" Text="0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Side 2 Road Width (0=none):"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Name="WestRoadWidthBox" Text="0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Internal Road Widths (0=none)" Padding="10" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Front Int. Road (m):"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Name="IntRoadFrontBox" Text="0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Rear Int. Road (m):"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Name="IntRoadRearBox" Text="0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Side 1 Int. Road (m):"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Name="IntRoadSide1Box" Text="0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Side 2 Int. Road (m):"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Name="IntRoadSide2Box" Text="0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Building Levels" Padding="10" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ground Level:"/>
                                <ComboBox Grid.Row="0" Grid.Column="1" Name="GroundLevelCombo"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Top Level:"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Name="TopLevelCombo"/>
                            </Grid>
                        </GroupBox>

                        <!-- Phase 4: Fire Safety Section -->
                        <GroupBox Header="Fire Safety (Reg 47-48)" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Occupancy Type:"/>
                                    <ComboBox Grid.Column="1" Name="OccupancyCombo">
                                        <ComboBoxItem Content="Residential" IsSelected="True"/>
                                        <ComboBoxItem Content="Residential - Hotel"/>
                                        <ComboBoxItem Content="Educational"/>
                                        <ComboBoxItem Content="Institutional - Hospital"/>
                                        <ComboBoxItem Content="Assembly"/>
                                        <ComboBoxItem Content="Commercial / Business"/>
                                        <ComboBoxItem Content="Mercantile"/>
                                        <ComboBoxItem Content="Industrial"/>
                                        <ComboBoxItem Content="Storage"/>
                                        <ComboBoxItem Content="Hazardous"/>
                                    </ComboBox>
                                </Grid>
                                <CheckBox Name="SprinklerCheckBox" 
                                          Content="Building has automatic sprinkler system (+50% travel distance)" 
                                          Margin="5,5,5,0"
                                          ToolTip="DCPR 2034 Reg 47(3)(ii): Travel distance increased by 50% with sprinklers in passages and corridors"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="Next: DCR Parameters →" 
                                Name="NextButton" 
                                Click="NextButton_Click"
                                HorizontalAlignment="Right"
                                Width="200"
                                Background="#0078D4"
                                Foreground="White"
                                Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: DCR Parameters -->
            <TabItem Header="DCR Parameters" Name="DCRTab">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Review and Edit DCR Parameters" 
                               FontSize="18" FontWeight="Bold" 
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" 
                              Name="DCRParametersGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="LightGray"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="Required Value" Binding="{Binding RequiredValue}" Width="150"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" IsReadOnly="True" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="← Back" Name="BackButton" Click="BackButton_Click" Width="100"/>
                        <Button Content="Run Compliance Check" 
                                Name="RunCheckButton" 
                                Click="RunCheckButton_Click" 
                                Width="200"
                                Background="#0078D4"
                                Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: Results -->
            <TabItem Header="Results" Name="ResultsTab">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Compliance Check Results" 
                               FontSize="18" FontWeight="Bold" 
                               Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" 
                              Name="ResultsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              AlternatingRowBackground="#F5F5F5"
                              RowHeight="30"
                              CanUserResizeRows="False">

                        <!-- Category Group Headers -->
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#0078D4" Padding="8,5" CornerRadius="2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontWeight="Bold" FontSize="13" 
                                                           Foreground="White"/>
                                                <TextBlock Text=" (" Foreground="White" FontSize="12"/>
                                                <TextBlock Text="{Binding ItemCount}" 
                                                           Foreground="White" FontSize="12"/>
                                                <TextBlock Text=" checks)" Foreground="White" FontSize="12"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Actual" Binding="{Binding Actual}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="PASS">
                                                <Setter Property="Foreground" Value="Green"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="FAIL">
                                                <Setter Property="Foreground" Value="Red"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="WARNING">
                                                <Setter Property="Foreground" Value="Orange"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Highlight Violations" 
                                Name="HighlightButton" 
                                Click="HighlightButton_Click" 
                                Width="150"
                                Background="#D13438"
                                Foreground="White"/>
                        <Button Content="Export Report" 
                                Name="ExportButton" 
                                Click="ExportButton_Click" 
                                Width="150"/>
                        <Button Content="Close" 
                                Name="CloseButton" 
                                Click="CloseButton_Click" 
                                Width="100"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
